### Rust ###
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

### Macos ###
# Ignore common Mac files
.DS_Store

### Local UI settings ###
**.ini

# Downloaded benchmark scene (see scripts/download_sponza.py).
assets/sponza/*.glb

# Local neural denoiser captures, checkpoints and Python environment.
training/.venv/
training/runs/

# Generated Python bytecode.
__pycache__/
*.py[cod]

# Reproducible roulette experiment captures.
performance/roulette/results/

# Sky importance sampling experiment captures.
performance/sky/results/

# High-sample rendering references.
performance/references/2048-rr/

# VNDF experiment images, radiance and generated reports.
performance/vndf/results/

# Local optimization sweep captures and machine-specific reports.
performance/local-sweep/results/

# Benchmark scenes downloaded/converted by scripts/convert_scene.py (see performance/scenes/README.md).
assets/scenes/

# Log of scripts/pc_run.sh --detach.
pc-run.log
